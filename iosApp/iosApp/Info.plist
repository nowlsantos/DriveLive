<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>DriveLive</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>GEMINI_API_KEY</key>
	<string>$(GEMINI_API_KEY)</string>

	<!-- Privacy Usage Descriptions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>DriveLive uses your microphone so you can talk hands-free with KAI while driving.</string>
	<key>NSCameraUsageDescription</key>
	<string>DriveLive uses your camera on demand when you ask KAI to inspect road signs, traffic, or hazards ahead.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DriveLive uses your location to ground navigation routes and nearby destination searches while driving.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DriveLive routes voice audio through your vehicle's Bluetooth hands-free system.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DriveLive reads your upcoming calendar events so KAI can give you a hands-free schedule briefing and route to your next meeting.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>DriveLive reads your upcoming calendar events so KAI can give you a hands-free schedule briefing.</string>

	<!-- External Navigation & Media URL Schemes (canOpenURL) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
		<string>spotify</string>
	</array>

	<!-- Keep Bidirectional Voice Session Alive During Navigation Handoffs -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Allow HTTP & HTTPS Audio Streams for Built-In Live Radio Player -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>